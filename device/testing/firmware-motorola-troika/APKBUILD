pkgname=firmware-motorola-troika
pkgver=1
pkgrel=0
pkgdesc="Firmware for Motorola One Action"
url="https://github.com/MotorolaMobilityLLC/kernel-slsi"
arch="aarch64"
# The ACPM plugin is a binary without source that Motorola publishes in its
# kernel source tree (firmware/) with no licence notice of its own.
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"

# Tag android-11-release-rsbs31.q1-48-36-26
_commit="d2ce55392f9f8b4efa332ee4ba205fe513c034b4"

source="
	exynos9610_acpm_fvp-$_commit.fw::$url/raw/$_commit/firmware/exynos9610_acpm_fvp.fw
	30-firmware-motorola-troika.files
"

package() {
	# The plugin of the power management firmware that sets frequencies
	# and voltages. The ACPM driver is built into the kernel and asks for
	# it before the root filesystem is there, so it goes to the initramfs.
	install -Dm644 "$srcdir"/exynos9610_acpm_fvp-$_commit.fw \
		"$pkgdir"/usr/lib/firmware/exynos9610_acpm_fvp.fw
	install -Dm644 "$srcdir"/30-firmware-motorola-troika.files \
		-t "$pkgdir"/usr/share/mkinitfs/files
}

sha512sums="
