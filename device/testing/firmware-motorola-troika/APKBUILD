pkgname=firmware-motorola-troika
pkgver=1
pkgrel=0
pkgdesc="Firmware for Motorola One Action"
url="https://github.com/MotorolaMobilityLLC/kernel-slsi"
arch="aarch64"
# The ACPM plugin is a binary without source that Motorola publishes in its
# kernel source tree (firmware/) with no licence notice of its own. The
# firmware of the WLBT radio and its configuration are vendor binaries from
# the vendor partition, mirrored by TheMuppets without a licence notice.
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"

# Tag android-11-release-rsbs31.q1-48-36-26
_commit="d2ce55392f9f8b4efa332ee4ba205fe513c034b4"

# Branch lineage-24.0
_muppets_commit="2dcb53b9f3379322d0c99aff435da3a03359e8ae"
_muppets_url="https://github.com/TheMuppets/proprietary_vendor_motorola_exynos9610-common/raw/$_muppets_commit/proprietary/vendor/etc/wifi"
_wlbt_conf="mx140/conf/leman_s620_troika_dualfem/wlan"

source="
	exynos9610_acpm_fvp-$_commit.fw::$url/raw/$_commit/firmware/exynos9610_acpm_fvp.fw
	30-firmware-motorola-troika.files
	mx140-$_muppets_commit.bin::$_muppets_url/mx140.bin
	wlan-$_muppets_commit.hcf::$_muppets_url/$_wlbt_conf/wlan.hcf
	wlan_sw-$_muppets_commit.hcf::$_muppets_url/$_wlbt_conf/wlan_sw.hcf
	wlan_t-$_muppets_commit.hcf::$_muppets_url/$_wlbt_conf/wlan_t.hcf
	wlan_t_sw-$_muppets_commit.hcf::$_muppets_url/$_wlbt_conf/wlan_t_sw.hcf
"

package() {
	# The plugin of the power management firmware that sets frequencies
	# and voltages. The ACPM driver is built into the kernel and asks for
	# it before the root filesystem is there, so it goes to the initramfs.
	install -Dm644 "$srcdir"/exynos9610_acpm_fvp-$_commit.fw \
		"$pkgdir"/usr/lib/firmware/exynos9610_acpm_fvp.fw
	install -Dm644 "$srcdir"/30-firmware-motorola-troika.files \
		-t "$pkgdir"/usr/share/mkinitfs/files

	# The firmware of the WLBT radio (WLAN) with the layout of the vendor
	# partition, where the SCSC driver looks for it. The driver asks for
	# the configuration next to the firmware as mx140_<name>.hcf.
	local _wlbt="$pkgdir"/usr/lib/firmware/motorola/troika
	local f
	install -Dm644 "$srcdir"/mx140-$_muppets_commit.bin "$_wlbt"/mx140.bin
	for f in wlan wlan_sw wlan_t wlan_t_sw; do
		install -Dm644 "$srcdir"/$f-$_muppets_commit.hcf \
			"$_wlbt"/$_wlbt_conf/$f.hcf
		ln -s $_wlbt_conf/$f.hcf "$_wlbt"/mx140_$f.hcf
	done
}

