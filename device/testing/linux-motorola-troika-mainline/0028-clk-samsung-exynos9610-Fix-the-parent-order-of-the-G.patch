From e70468c4a3cfcc4e2c5d86d44f6c93961b1f9175 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Wed, 11 Nov 2026 13:43:29 +0100
Subject: [PATCH 28/52] clk: samsung: exynos9610: Fix the parent order of the
 GIC mux

In the vendor kernel's clock tables
(drivers/soc/samsung/cal-if/exynos9610/cmucal-node.c and cmucal-sfr.c)
the inputs of MUX_CLK_CORE_GIC are DIV_CLK_CORE_BUSP (0) and OSCCLK_CORE
(1). The driver lists them the other way round, so the clock framework
reports the oscillator while the GIC runs from the bus clock, and the
other way round.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/clk/samsung/clk-exynos9610.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/samsung/clk-exynos9610.c b/drivers/clk/samsung/clk-exynos9610.c
index 25ee303..76cd458 100644
--- a/drivers/clk/samsung/clk-exynos9610.c
+++ b/drivers/clk/samsung/clk-exynos9610.c
@@ -2338,8 +2338,8 @@ PNAME(mout_pll_core_cci_user_p)	=	 { "oscclk",
 					    "dout_cmu_core_cci" };
 PNAME(mout_pll_core_g3d_user_p)	=	 { "oscclk",
 					    "dout_cmu_core_g3d" };
-PNAME(mout_clk_core_gic_p)		= { "oscclk",
-					    "dout_clk_core_busp" };
+PNAME(mout_clk_core_gic_p)		= { "dout_clk_core_busp",
+					    "oscclk" };
 
 static const struct samsung_mux_clock core_mux_clks[] __initconst = {
 	MUX(CLK_MOUT_PLL_CORE_BUS_USER, "mout_pll_core_bus_user", mout_pll_core_bus_user_p,
