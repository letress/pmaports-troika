From 8fa14a479713832afa560342febe2aa6c94dfa0b Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Wed, 11 Nov 2026 14:33:59 +0100
Subject: [PATCH 52/52] arm64: dts: exynos9610-troika: Enable USB in device
 mode

Enable the USB controller and its PHY as a high-speed peripheral, which
is enough for a network or serial gadget. The vendor tree limits the
port to high speed as well and uses it as OTG; host mode needs the
Type-C controller and the VBUS boost of the S2MU106, neither of which
is described.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 .../boot/dts/exynos/exynos9610-troika.dts     | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos9610-troika.dts b/arch/arm64/boot/dts/exynos/exynos9610-troika.dts
index 90e45e2..23d20cf 100644
--- a/arch/arm64/boot/dts/exynos/exynos9610-troika.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9610-troika.dts
@@ -143,3 +143,22 @@ key_volup: key-volup-pins {
 		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
 	};
 };
+
+/*
+ * Device mode only: nothing here can tell which way round the Type-C cable is
+ * or whether there is a host on the other end, and VBUS is never driven. The
+ * data lines go through the MUIC of the S2MU106, which is left as the
+ * bootloader set it.
+ */
+&usbdrd {
+	status = "okay";
+};
+
+&usbdrd_dwc3 {
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+};
+
+&usbdrd_phy {
+	status = "okay";
+};
