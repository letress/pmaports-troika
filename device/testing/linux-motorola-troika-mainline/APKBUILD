builddir="$srcdir/linux-$pkgver"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config

	# default_prepare only applies *.patch to the kernel tree
	local i
	for i in "$srcdir"/uniloader-*.diff; do
		msg "uniLoader: $(basename "$i")"
		patch -p1 -d "$_uniloader_dir" -i "$i"
	done
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"

	# uniLoader with the kernel and the mainline device tree inside. The
	# ramdisk stays in the boot image: the bootloader loads it and uniLoader
	# takes its location from the bootloader's device tree, so the file
	# below is only a placeholder the build wants to stat.
	cp arch/arm64/boot/Image "$_uniloader_dir"/blob/Image
	cp arch/arm64/boot/dts/exynos/exynos9610-troika.dtb "$_uniloader_dir"/blob/dtb
	head -c 4096 /dev/zero > "$_uniloader_dir"/blob/ramdisk
	make -C "$_uniloader_dir" ARCH=aarch64 troika_defconfig
	make -C "$_uniloader_dir" ARCH=aarch64
}

package() {
	mkdir -p "$pkgdir"/boot

	# The stock kernel is an uncompressed Image; whether the bootloader
	# accepts a compressed one is unknown.
	make install modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release

	# Picked up by mkinitfs through deviceinfo_uboot_boardname and put into
	# the boot image instead of the kernel (deviceinfo_bootimg_override_payload)
	install -Dm644 "$_uniloader_dir"/uniLoader \
		"$pkgdir"/usr/share/u-boot/motorola-troika/uniLoader
}

