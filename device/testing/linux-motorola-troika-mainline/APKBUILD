_config="config-$_flavor.$arch"
_kmajver="${pkgver%%.*}"
# The stock bootloader only accepts a boot image that carries its own vendor
# device tree, so the kernel and the mainline device tree are wrapped in
# uniLoader, which is what ends up in the boot image (see device package).
_uniloader_commit="30442c60e34de64f4cc7c4236f878e84b4516d86"
_uniloader_dir="$srcdir/uniLoader-$_uniloader_commit"
# The WLAN driver is Samsung's out-of-tree SCSC driver (release 11.19.0.46.0
# from the kernel sources of the Galaxy Tab S6 Lite) with its port to Linux
# 7.3 from github.com/arhammahajan/gta4xl-linux and the firmware location of
# this device. It is built here against the kernel of this package.
_scsc_dir="$srcdir/scsc-wlbt-troika"
