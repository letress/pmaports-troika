# Reference: <https://nura.eco/vendorkernel>
# Kernel config based on: device/testing/linux-postmarketos-exynos850
pkgname=linux-motorola-troika-mainline
pkgver=7.3.3
pkgrel=1
pkgdesc="Mainline kernel for Motorola One Action (Exynos 9609)"
arch="aarch64"
_carch="arm64"
_flavor="motorola-troika-mainline"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	elfutils-dev
	findutils
	flex
	linux-headers
	openssl-dev
	perl
	postmarketos-installkernel
	python3
"

# Source
_config="config-$_flavor.$arch"
_kmajver="${pkgver%%.*}"
# The stock bootloader only accepts a boot image that carries its own vendor
# device tree, so the kernel and the mainline device tree are wrapped in
# uniLoader, which is what ends up in the boot image (see device package).
_uniloader_commit="30442c60e34de64f4cc7c4236f878e84b4516d86"
_uniloader_dir="$srcdir/uniLoader-$_uniloader_commit"
source="
	https://cdn.kernel.org/pub/linux/kernel/v$_kmajver.x/linux-$pkgver.tar.xz
	uniLoader-$_uniloader_commit.tar.gz::https://github.com/ivoszbg/uniLoader/archive/$_uniloader_commit.tar.gz
	$_config
	uniloader-0001-board-motorola-Add-Motorola-One-Action-troika.diff
	uniloader-0002-Inherit-initrd-and-bootargs-from-the-previous-bootlo.diff
	0001-dt-bindings-arm-samsung-Document-gta4xl-board-bindin.patch
	0002-arm64-dts-exynos-Add-initial-support-for-the-Exynos9.patch
	0003-arm64-dts-exynos-Add-initial-support-for-Samsung-Gal.patch
	0004-dt-bindings-arm-samsung-Fix-indentation-and-order-of.patch
	0005-arm64-dts-exynos9610-Fix-misspelled-samsung-pin-pud-.patch
	0006-arm64-dts-exynos9610-Use-two-interrupt-cells-for-the.patch
	0007-arm64-dts-exynos9610-Rename-xclkout-pin-groups-to-ma.patch
	0008-arm64-dts-exynos9610-Fix-GIC-unit-address.patch
	0009-arm64-dts-exynos9610-Use-GIC-defines-for-the-PMU-int.patch
	0010-arm64-dts-exynos9610-Move-ramoops-to-the-gta4xl-boar.patch
	0011-arm64-dts-exynos9610-Move-the-ABOX-reservation-to-gt.patch
	0012-arm64-dts-exynos9610-Set-the-oscillator-frequency-in.patch
	0013-arm64-dts-exynos9610-gta4xl-Add-the-required-model-p.patch
	0014-arm64-dts-exynos9610-gta4xl-Use-lowercase-hex-in-the.patch
	0015-arm64-dts-exynos9610-gta4xl-Drop-unit-address-from-t.patch
	0016-dt-bindings-arm-samsung-Document-Motorola-One-Action.patch
	0017-arm64-dts-exynos-Add-Motorola-One-Action-troika.patch
"
builddir="$srcdir/linux-$pkgver"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config

	# default_prepare only applies *.patch to the kernel tree
	local i
	for i in "$srcdir"/uniloader-*.diff; do
		msg "uniLoader: $(basename "$i")"
		patch -p1 -d "$_uniloader_dir" -i "$i"
	done
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"

	# uniLoader with the kernel and the mainline device tree inside. The
	# ramdisk stays in the boot image: the bootloader loads it and uniLoader
	# takes its location from the bootloader's device tree, so the file
	# below is only a placeholder the build wants to stat.
	cp arch/arm64/boot/Image "$_uniloader_dir"/blob/Image
	cp arch/arm64/boot/dts/exynos/exynos9610-troika.dtb "$_uniloader_dir"/blob/dtb
	head -c 4096 /dev/zero > "$_uniloader_dir"/blob/ramdisk
	make -C "$_uniloader_dir" ARCH=aarch64 troika_defconfig
	make -C "$_uniloader_dir" ARCH=aarch64
}

package() {
	mkdir -p "$pkgdir"/boot

	# The stock kernel is an uncompressed Image; whether the bootloader
	# accepts a compressed one is unknown.
	make install modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release

	# Picked up by mkinitfs through deviceinfo_uboot_boardname and put into
	# the boot image instead of the kernel (deviceinfo_bootimg_override_payload)
	install -Dm644 "$_uniloader_dir"/uniLoader \
		"$pkgdir"/usr/share/u-boot/motorola-troika/uniLoader
}

