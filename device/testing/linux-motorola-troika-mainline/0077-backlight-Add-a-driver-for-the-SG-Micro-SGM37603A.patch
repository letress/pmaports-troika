From 3a10958b608abc8fea23d6399509aa3af1ffd069 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Thu, 12 Nov 2026 14:08:39 +0100
Subject: [PATCH 77/94] backlight: Add a driver for the SG Micro SGM37603A

The SGM37603A drives up to three strings of white LEDs. The driver sets
the 12-bit brightness code and leaves the rest of the configuration as
it finds it, including the brightness mode: out of reset the LED current
is the product of the code and the duty cycle of the PWM input.

The brightness is read back at probe time, so a backlight that the
bootloader has turned on keeps its level.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/video/backlight/Kconfig     |   8 ++
 drivers/video/backlight/Makefile    |   1 +
 drivers/video/backlight/sgm37603a.c | 121 ++++++++++++++++++++++++++++
 3 files changed, 130 insertions(+)
 create mode 100644 drivers/video/backlight/sgm37603a.c

diff --git a/drivers/video/backlight/Kconfig b/drivers/video/backlight/Kconfig
index dbf4ca2..45e17ad 100644
--- a/drivers/video/backlight/Kconfig
+++ b/drivers/video/backlight/Kconfig
@@ -215,6 +215,14 @@ config BACKLIGHT_SY7758
 	  Say Y to enable the backlight driver for the Silergy SY7758
 	  backlight controller found in Ayaneo Pocket S2.
 
+config BACKLIGHT_SGM37603A
+	tristate "Backlight Driver for SG Micro SGM37603A"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  Say Y to enable the backlight driver for the SG Micro SGM37603A
+	  3-string white LED driver found in the Motorola One Action.
+
 config BACKLIGHT_LM3533
 	tristate "Backlight Driver for LM3533"
 	depends on MFD_LM3533
diff --git a/drivers/video/backlight/Makefile b/drivers/video/backlight/Makefile
index 3446971..23f6044 100644
--- a/drivers/video/backlight/Makefile
+++ b/drivers/video/backlight/Makefile
@@ -57,6 +57,7 @@ obj-$(CONFIG_BACKLIGHT_PWM)		+= pwm_bl.o
 obj-$(CONFIG_BACKLIGHT_QCOM_WLED)	+= qcom-wled.o
 obj-$(CONFIG_BACKLIGHT_RT4831)		+= rt4831-backlight.o
 obj-$(CONFIG_BACKLIGHT_SAHARA)		+= kb3886_bl.o
+obj-$(CONFIG_BACKLIGHT_SGM37603A)	+= sgm37603a.o
 obj-$(CONFIG_BACKLIGHT_SY7758)		+= sy7758.o
 obj-$(CONFIG_BACKLIGHT_SKY81452)	+= sky81452-backlight.o
 obj-$(CONFIG_BACKLIGHT_TPS65217)	+= tps65217_bl.o
diff --git a/drivers/video/backlight/sgm37603a.c b/drivers/video/backlight/sgm37603a.c
new file mode 100644
index 0000000..3b05a79
--- /dev/null
+++ b/drivers/video/backlight/sgm37603a.c
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * SG Micro SGM37603A 3-string white LED driver
+ *
+ * Only the brightness code is handled. The enable bits, the brightness mode
+ * and the maximum LED current stay as the bootloader or the reset left them.
+ */
+
+#include <linux/backlight.h>
+#include <linux/bits.h>
+#include <linux/i2c.h>
+#include <linux/minmax.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+
+#define SGM37603A_REG_BRT_MSB		0x19
+#define SGM37603A_REG_BRT_LSB		0x1a
+#define SGM37603A_REG_MAX		0x1f
+
+#define SGM37603A_BRT_LSB_MASK		GENMASK(3, 0)
+
+#define SGM37603A_MAX_BRIGHTNESS	4095
+
+static const struct regmap_config sgm37603a_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = SGM37603A_REG_MAX,
+};
+
+static int sgm37603a_update_status(struct backlight_device *bl)
+{
+	struct regmap *regmap = bl_get_data(bl);
+	unsigned int brightness = backlight_get_brightness(bl);
+	int ret;
+
+	ret = regmap_update_bits(regmap, SGM37603A_REG_BRT_LSB,
+				 SGM37603A_BRT_LSB_MASK, brightness & 0xf);
+	if (ret)
+		return ret;
+
+	return regmap_write(regmap, SGM37603A_REG_BRT_MSB, brightness >> 4);
+}
+
+static const struct backlight_ops sgm37603a_backlight_ops = {
+	.options = BL_CORE_SUSPENDRESUME,
+	.update_status = sgm37603a_update_status,
+};
+
+static int sgm37603a_read_brightness(struct regmap *regmap)
+{
+	unsigned int msb, lsb;
+	int ret;
+
+	ret = regmap_read(regmap, SGM37603A_REG_BRT_MSB, &msb);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(regmap, SGM37603A_REG_BRT_LSB, &lsb);
+	if (ret)
+		return ret;
+
+	return msb << 4 | (lsb & SGM37603A_BRT_LSB_MASK);
+}
+
+static int sgm37603a_probe(struct i2c_client *client)
+{
+	struct backlight_properties props = { };
+	struct device *dev = &client->dev;
+	struct backlight_device *bl;
+	struct regmap *regmap;
+	u32 max_brightness;
+	int brightness;
+
+	regmap = devm_regmap_init_i2c(client, &sgm37603a_regmap_config);
+	if (IS_ERR(regmap))
+		return dev_err_probe(dev, PTR_ERR(regmap),
+				     "failed to init regmap\n");
+
+	brightness = sgm37603a_read_brightness(regmap);
+	if (brightness < 0)
+		return dev_err_probe(dev, brightness,
+				     "failed to read the brightness\n");
+
+	max_brightness = SGM37603A_MAX_BRIGHTNESS;
+	device_property_read_u32(dev, "max-brightness", &max_brightness);
+	if (max_brightness > SGM37603A_MAX_BRIGHTNESS)
+		max_brightness = SGM37603A_MAX_BRIGHTNESS;
+
+	props.type = BACKLIGHT_RAW;
+	props.scale = BACKLIGHT_SCALE_LINEAR;
+	props.max_brightness = max_brightness;
+	props.brightness = min_t(u32, brightness, max_brightness);
+
+	bl = devm_backlight_device_register(dev, dev_name(dev), dev, regmap,
+					    &sgm37603a_backlight_ops, &props);
+	if (IS_ERR(bl))
+		return dev_err_probe(dev, PTR_ERR(bl),
+				     "failed to register the backlight\n");
+
+	return 0;
+}
+
+static const struct of_device_id sgm37603a_of_match[] = {
+	{ .compatible = "sgmicro,sgm37603a" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sgm37603a_of_match);
+
+static struct i2c_driver sgm37603a_driver = {
+	.driver = {
+		.name = "sgm37603a",
+		.of_match_table = sgm37603a_of_match,
+	},
+	.probe = sgm37603a_probe,
+};
+module_i2c_driver(sgm37603a_driver);
+
+MODULE_DESCRIPTION("SG Micro SGM37603A backlight driver");
+MODULE_LICENSE("GPL");
