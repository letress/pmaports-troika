From f422828c514d4f70b74d2f8d44ca4ecae747ae37 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Wed, 11 Nov 2026 14:33:36 +0100
Subject: [PATCH 50/67] usb: dwc3: exynos: Add support for Exynos9610

The DWC3 glue of the Exynos9610 needs the same two clocks as the one of
the Exynos850, so reuse its driver data.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/usb/dwc3/dwc3-exynos.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/usb/dwc3/dwc3-exynos.c b/drivers/usb/dwc3/dwc3-exynos.c
index e934f94..98e4c86 100644
--- a/drivers/usb/dwc3/dwc3-exynos.c
+++ b/drivers/usb/dwc3/dwc3-exynos.c
@@ -212,6 +212,9 @@ static const struct of_device_id exynos_dwc3_match[] = {
 	}, {
 		.compatible = "samsung,exynos850-dwusb3",
 		.data = &exynos850_drvdata,
+	}, {
+		.compatible = "samsung,exynos9610-dwusb3",
+		.data = &exynos850_drvdata,
 	}, {
 		.compatible = "samsung,exynosautov920-dwusb3",
 		.data = &exynosautov920_drvdata,
