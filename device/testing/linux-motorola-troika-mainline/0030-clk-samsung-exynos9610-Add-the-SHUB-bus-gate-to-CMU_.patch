From e3d8129da611e6a150095548b9a48a00cba385ba Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Wed, 11 Nov 2026 13:43:29 +0100
Subject: [PATCH 30/95] clk: samsung: exynos9610: Add the SHUB bus gate to
 CMU_APM

dout_cmu_shub_bus has "gout_cmu_shub_bus" as its parent, but no such
gate is registered, although its register
(CLK_CON_GAT_GATE_CLKCMU_SHUB_BUS, 0x2010) is defined and saved over
suspend. The divider is an orphan.

Add the gate. In the vendor kernel's clock tables
(drivers/soc/samsung/cal-if/exynos9610/cmucal-node.c and cmucal-sfr.c)
it is GATE_CLKCMU_SHUB_BUS, bit 21, with MUX_CLKCMU_SHUB_BUS as its
parent. This needs a new clock ID, added at the end of the CMU_APM list.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/clk/samsung/clk-exynos9610.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/clk/samsung/clk-exynos9610.c b/drivers/clk/samsung/clk-exynos9610.c
index 76cd458..0c2767e 100644
--- a/drivers/clk/samsung/clk-exynos9610.c
+++ b/drivers/clk/samsung/clk-exynos9610.c
@@ -17,7 +17,7 @@
 #include "clk-pll.h"
 
 #define CLKS_NR_TOP	(CLK_GOUT_CMU_VIPX2_BUS + 1)
-#define CLKS_NR_APM	(CLK_GOUT_APM_XIU_DP_ACLK + 1)
+#define CLKS_NR_APM	(CLK_GOUT_CMU_SHUB_BUS + 1)
 #define CLKS_NR_CAM	(CLK_GOUT_CAM_SYSREG_PCLK + 1)
 #define CLKS_NR_CMGP	(CLK_GOUT_CMGP_USI_CMGP04_PCLK + 1)
 #define CLKS_NR_CORE	(CLK_GOUT_CORE_XIU_D_ACLK + 1)
@@ -1487,6 +1487,8 @@ static const struct samsung_div_clock apm_div_clks[] __initconst = {
 static const struct samsung_gate_clock apm_gate_clks[] __initconst = {
 	GATE(CLK_GOUT_CMU_CMGP_BUS, "gout_cmu_cmgp_bus", "dout_clk_apm_bus",
 	     CLK_CON_GAT_CLKCMU_CMGP_BUS, 21, 0, 0),
+	GATE(CLK_GOUT_CMU_SHUB_BUS, "gout_cmu_shub_bus", "mout_cmu_shub_bus",
+	     CLK_CON_GAT_GATE_CLKCMU_SHUB_BUS, 21, 0, 0),
 	GATE(CLK_GOUT_CLK_APM_CMU_PCLK, "gout_clk_apm_cmu_pclk", "dout_clk_apm_bus",
 	     CLK_CON_GAT_CLK_APM_CMU_PCLK, 21, 0, 0),
 	GATE(CLK_GOUT_CLK_APM_OSCCLK_CLK, "gat_clk_apm_oscclk_clk", "oscclk",
