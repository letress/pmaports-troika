From b64b0aa11e446af2d222f5dd62bcce0e065e362b Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Thu, 12 Nov 2026 15:20:24 +0100
Subject: [PATCH 82/94] dt-bindings: mailbox: google,gs101-mbox: Add Exynos9610

The AP to APM mailbox of the Exynos9610 rings the doorbell through
INTGR0 and masks the interrupts of the APM in INTMR1, like the one of
the Exynos850 (acpm_ipc.c of the vendor kernel).

Co-Authored-By: Claude <noreply@anthropic.com>
---
 .../devicetree/bindings/mailbox/google,gs101-mbox.yaml | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/Documentation/devicetree/bindings/mailbox/google,gs101-mbox.yaml b/Documentation/devicetree/bindings/mailbox/google,gs101-mbox.yaml
index c109c1f..06d379a 100644
--- a/Documentation/devicetree/bindings/mailbox/google,gs101-mbox.yaml
+++ b/Documentation/devicetree/bindings/mailbox/google,gs101-mbox.yaml
@@ -20,9 +20,13 @@ description:
 
 properties:
   compatible:
-    enum:
-      - google,gs101-mbox
-      - samsung,exynos850-mbox
+    oneOf:
+      - enum:
+          - google,gs101-mbox
+          - samsung,exynos850-mbox
+      - items:
+          - const: samsung,exynos9610-mbox
+          - const: samsung,exynos850-mbox
 
   reg:
     maxItems: 1
