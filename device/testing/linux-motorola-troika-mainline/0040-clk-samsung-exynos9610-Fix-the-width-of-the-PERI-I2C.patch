From 0715dcedb6593464dd4252ac8cc848757dbd6918 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Wed, 11 Nov 2026 13:43:32 +0100
Subject: [PATCH 40/67] clk: samsung: exynos9610: Fix the width of the PERI I2C
 divider

dout_clk_peri_i2c is registered with an 8 bit ratio. In the vendor
kernel's clock tables
(drivers/soc/samsung/cal-if/exynos9610/cmucal-node.c and cmucal-sfr.c)
DIV_CLK_PERI_I2C has a 4 bit DIVRATIO field.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/clk/samsung/clk-exynos9610.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/clk/samsung/clk-exynos9610.c b/drivers/clk/samsung/clk-exynos9610.c
index dc7265f..82fbb3a 100644
--- a/drivers/clk/samsung/clk-exynos9610.c
+++ b/drivers/clk/samsung/clk-exynos9610.c
@@ -1189,7 +1189,7 @@ static const struct samsung_mux_clock peri_mux_clks[] __initconst = {
 
 static const struct samsung_div_clock peri_div_clks[] __initconst = {
 	DIV(CLK_DOUT_CLK_PERI_I2C, "dout_clk_peri_i2c", "gout_clk_peri_i2c",
-	    CLK_CON_DIV_DIV_CLK_PERI_I2C, 0, 8),
+	    CLK_CON_DIV_DIV_CLK_PERI_I2C, 0, 4),
 	DIV(CLK_DOUT_CLK_PERI_SPI0, "dout_clk_peri_spi0", "gout_clk_peri_spi0",
 	    CLK_CON_DIV_DIV_CLK_PERI_SPI0, 0, 8),
 	DIV(CLK_DOUT_CLK_PERI_SPI1, "dout_clk_peri_spi1", "gout_clk_peri_spi1",
