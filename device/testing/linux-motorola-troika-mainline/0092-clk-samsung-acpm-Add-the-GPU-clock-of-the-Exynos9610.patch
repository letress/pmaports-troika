From 37036ce7cf189a0ae2bf9e94f1ed6a7eeb742c69 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Thu, 12 Nov 2026 21:25:13 +0100
Subject: [PATCH 92/95] clk: samsung: acpm: Add the GPU clock of the Exynos9610

On the Exynos9610 the firmware reprograms the PLL of the GPU in CMU_G3D
and sets the voltage that the rate needs. The firmware cannot tell the
rate, so register the clock as a child of the clock in the CMU: its
rate is the one of the parent until the first request and the requested
one afterwards. The parent also takes care of the gating.

Only the GPU domain is registered, the IDs of the other domains stay
unused. Without the firmware plugin that serves the requests the rate
stays where the bootloader left it.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/clk/samsung/clk-acpm.c | 100 +++++++++++++++++++++++++++++----
 1 file changed, 89 insertions(+), 11 deletions(-)

diff --git a/drivers/clk/samsung/clk-acpm.c b/drivers/clk/samsung/clk-acpm.c
index 7680bc8..341d027 100644
--- a/drivers/clk/samsung/clk-acpm.c
+++ b/drivers/clk/samsung/clk-acpm.c
@@ -13,6 +13,7 @@
 #include <linux/err.h>
 #include <linux/firmware/samsung/exynos-acpm-protocol.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/types.h>
 
@@ -21,10 +22,19 @@ struct acpm_clk {
 	struct clk_hw hw;
 	unsigned int mbox_chan_id;
 	struct acpm_handle *handle;
+	unsigned long rate;
+	bool fixed;
 };
 
+/*
+ * A clock without a name is not registered. A clock with a parent is a clock
+ * of a CMU that the firmware changes the rate of: the firmware cannot tell
+ * the rate, so it is the rate of the parent until the first request and the
+ * requested rate from then on.
+ */
 struct acpm_clk_variant {
 	const char *name;
+	const char *parent;
 };
 
 struct acpm_clk_driver_data {
@@ -63,6 +73,16 @@ static const struct acpm_clk_driver_data acpm_clk_gs101 = {
 	.mbox_chan_id = 0,
 };
 
+static const struct acpm_clk_variant exynos9610_acpm_clks[] = {
+	[4] = { .name = "acpm_g3d", .parent = "g3d" },
+};
+
+static const struct acpm_clk_driver_data acpm_clk_exynos9610 = {
+	.clks = exynos9610_acpm_clks,
+	.nr_clks = ARRAY_SIZE(exynos9610_acpm_clks),
+	.mbox_chan_id = 0,
+};
+
 static unsigned long acpm_clk_recalc_rate(struct clk_hw *hw,
 					  unsigned long parent_rate)
 {
@@ -87,13 +107,60 @@ static const struct clk_ops acpm_clk_ops = {
 	.set_rate = acpm_clk_set_rate,
 };
 
+static unsigned long acpm_clk_tracked_recalc_rate(struct clk_hw *hw,
+						  unsigned long parent_rate)
+{
+	struct acpm_clk *clk = to_acpm_clk(hw);
+
+	return clk->rate ?: parent_rate;
+}
+
+static int acpm_clk_tracked_determine_rate(struct clk_hw *hw,
+					   struct clk_rate_request *req)
+{
+	struct acpm_clk *clk = to_acpm_clk(hw);
+
+	/* The firmware cannot change the rate, keep the current one. */
+	if (clk->fixed)
+		req->rate = clk_hw_get_rate(hw);
+
+	return 0;
+}
+
+static int acpm_clk_tracked_set_rate(struct clk_hw *hw, unsigned long rate,
+				     unsigned long parent_rate)
+{
+	struct acpm_clk *clk = to_acpm_clk(hw);
+	int ret;
+
+	ret = acpm_clk_set_rate(hw, rate, parent_rate);
+	if (ret)
+		return ret;
+
+	clk->rate = rate;
+
+	return 0;
+}
+
+static const struct clk_ops acpm_clk_tracked_ops = {
+	.recalc_rate = acpm_clk_tracked_recalc_rate,
+	.determine_rate = acpm_clk_tracked_determine_rate,
+	.set_rate = acpm_clk_tracked_set_rate,
+};
+
 static int acpm_clk_register(struct device *dev, struct acpm_clk *aclk,
-			     const char *name)
+			     const struct acpm_clk_variant *variant)
 {
+	struct clk_parent_data parent = { .fw_name = variant->parent };
 	struct clk_init_data init = {};
 
-	init.name = name;
+	init.name = variant->name;
 	init.ops = &acpm_clk_ops;
+	if (variant->parent) {
+		init.ops = &acpm_clk_tracked_ops;
+		init.parent_data = &parent;
+		init.num_parents = 1;
+	}
 	aclk->hw.init = &init;
 
 	return devm_clk_hw_register(dev, &aclk->hw);
@@ -101,6 +168,8 @@ static int acpm_clk_register(struct device *dev, struct acpm_clk *aclk,
 
 static int acpm_clk_probe(struct platform_device *pdev)
 {
+	const struct acpm_clk_driver_data *data;
+	const bool *plugins_attached = dev_get_platdata(&pdev->dev);
 	struct acpm_handle *acpm_handle;
 	struct clk_hw_onecell_data *clk_data;
 	struct clk_hw **hws;
@@ -114,8 +183,12 @@ static int acpm_clk_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, PTR_ERR(acpm_handle),
 				     "Failed to get acpm handle\n");
 
-	count = acpm_clk_gs101.nr_clks;
-	mbox_chan_id = acpm_clk_gs101.mbox_chan_id;
+	data = (const void *)platform_get_device_id(pdev)->driver_data;
+	count = data->nr_clks;
+	mbox_chan_id = data->mbox_chan_id;
+
+	/* The parents of the clocks are in the node of the ACPM device. */
+	device_set_of_node_from_dev(dev, dev->parent);
 
 	clk_data = devm_kzalloc(dev, struct_size(clk_data, hws, count),
 				GFP_KERNEL);
@@ -132,18 +205,20 @@ static int acpm_clk_probe(struct platform_device *pdev)
 	for (i = 0; i < count; i++) {
 		struct acpm_clk *aclk = &aclks[i];
 
-		/*
-		 * The code assumes the clock IDs start from zero,
-		 * are sequential and do not have gaps.
-		 */
+		/* The clock IDs are the indices of the table. */
+		if (!data->clks[i].name) {
+			hws[i] = ERR_PTR(-ENOENT);
+			continue;
+		}
+
 		aclk->id = i;
 		aclk->handle = acpm_handle;
 		aclk->mbox_chan_id = mbox_chan_id;
+		aclk->fixed = plugins_attached && !*plugins_attached;
 
 		hws[i] = &aclk->hw;
 
-		err = acpm_clk_register(dev, aclk,
-					acpm_clk_gs101.clks[i].name);
+		err = acpm_clk_register(dev, aclk, &data->clks[i]);
 		if (err)
 			return dev_err_probe(dev, err,
 					     "Failed to register clock\n");
@@ -154,7 +229,10 @@ static int acpm_clk_probe(struct platform_device *pdev)
 }
 
 static const struct platform_device_id acpm_clk_id[] = {
-	{ .name = "gs101-acpm-clk" },
+	{ .name = "gs101-acpm-clk",
+	  .driver_data = (kernel_ulong_t)&acpm_clk_gs101 },
+	{ .name = "exynos9610-acpm-clk",
+	  .driver_data = (kernel_ulong_t)&acpm_clk_exynos9610 },
 	{ }
 };
 MODULE_DEVICE_TABLE(platform, acpm_clk_id);
