From 48a0766fe1a68ae96f32abc606c6489acd228e6d Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Wed, 11 Nov 2026 13:43:32 +0100
Subject: [PATCH 42/95] clk: samsung: exynos9610: Rename the MFC divider IDs

CLK_DOUT_CMU_MFD_MFC and CLK_DOUT_CMU_MFD_WFD belong to the MFC block,
like the matching mux and gate IDs. "MFD" is a typo.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/clk/samsung/clk-exynos9610.c               | 4 ++--
 include/dt-bindings/clock/samsung,exynos9610-cmu.h | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/clk/samsung/clk-exynos9610.c b/drivers/clk/samsung/clk-exynos9610.c
index e3054b2..6aad660 100644
--- a/drivers/clk/samsung/clk-exynos9610.c
+++ b/drivers/clk/samsung/clk-exynos9610.c
@@ -682,9 +682,9 @@ static const struct samsung_div_clock top_div_clks[] __initconst = {
 	    CLK_CON_DIV_CLKCMU_ISP_GDC, 0, 4),
 	DIV(CLK_DOUT_CMU_ISP_VRA, "dout_cmu_isp_vra", "gout_cmu_isp_vra",
 	    CLK_CON_DIV_CLKCMU_ISP_VRA, 0, 4),
-	DIV(CLK_DOUT_CMU_MFD_MFC, "dout_cmu_mfc_mfc", "gout_cmu_mfc_mfc",
+	DIV(CLK_DOUT_CMU_MFC_MFC, "dout_cmu_mfc_mfc", "gout_cmu_mfc_mfc",
 	    CLK_CON_DIV_CLKCMU_MFC_MFC, 0, 4),
-	DIV(CLK_DOUT_CMU_MFD_WFD, "dout_cmu_mfc_wfd", "gout_cmu_mfc_wfd",
+	DIV(CLK_DOUT_CMU_MFC_WFD, "dout_cmu_mfc_wfd", "gout_cmu_mfc_wfd",
 	    CLK_CON_DIV_CLKCMU_MFC_WFD, 0, 4),
 	DIV(CLK_DOUT_CMU_MIF_BUSP, "dout_cmu_mif_busp", "gout_cmu_mif_busp",
 	    CLK_CON_DIV_CLKCMU_MIF_BUSP, 0, 3),
diff --git a/include/dt-bindings/clock/samsung,exynos9610-cmu.h b/include/dt-bindings/clock/samsung,exynos9610-cmu.h
index e8a2c5c..57afb73 100644
--- a/include/dt-bindings/clock/samsung,exynos9610-cmu.h
+++ b/include/dt-bindings/clock/samsung,exynos9610-cmu.h
@@ -94,8 +94,8 @@
 #define CLK_DOUT_CMU_ISP_BUS		79
 #define CLK_DOUT_CMU_ISP_GDC		80
 #define CLK_DOUT_CMU_ISP_VRA		81
-#define CLK_DOUT_CMU_MFD_MFC		82
-#define CLK_DOUT_CMU_MFD_WFD		83
+#define CLK_DOUT_CMU_MFC_MFC		82
+#define CLK_DOUT_CMU_MFC_WFD		83
 #define CLK_DOUT_CMU_MIF_BUSP		84
 #define CLK_DOUT_CMU_PERI_BUS		85
 #define CLK_DOUT_CMU_PERI_IP		86
