--- a/drivers/phy/samsung/Makefile
+++ b/drivers/phy/samsung/Makefile
@@ -6,6 +6,7 @@ obj-$(CONFIG_PHY_SAMSUNG_UFS)		+= phy-exynos-ufs.o
 phy-exynos-ufs-y			+= phy-gs101-ufs.o
 phy-exynos-ufs-y			+= phy-samsung-ufs.o
 phy-exynos-ufs-y			+= phy-exynos7-ufs.o
+phy-exynos-ufs-y			+= phy-exynos9610-ufs.o
 phy-exynos-ufs-y			+= phy-exynosautov9-ufs.o
 phy-exynos-ufs-y			+= phy-exynosautov920-ufs.o
 phy-exynos-ufs-y			+= phy-fsd-ufs.o
diff --git a/drivers/phy/samsung/phy-exynos9610-ufs.c b/drivers/phy/samsung/phy-exynos9610-ufs.c
new file mode 100644
index 0000000..01b5540
--- /dev/null
+++ b/drivers/phy/samsung/phy-exynos9610-ufs.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * UFS PHY driver data for Samsung Exynos9610 SoC
+ *
+ * The register values are those of the vendor kernel (ufs-cal-9610.c), which
+ * gives them as byte offsets into the PMA; they are register numbers here.
+ */
+
+#include "phy-samsung-ufs.h"
+
+#define EXYNOS9610_EMBEDDED_UFS_PHY_CTRL	0x724
+#define EXYNOS9610_EMBEDDED_UFS_PHY_CTRL_MASK	0x1
+#define EXYNOS9610_EMBEDDED_UFS_PHY_CTRL_EN	BIT(0)
+
+#define PHY_EXYNOS9610_LANE_OFFSET		0x50
+#define PHY_EXYNOS9610_CDR_LOCK_STATUS		0x7f
+#define PHY_EXYNOS9610_CDR_LOCK_BIT		BIT(6)
+
+#define PHY_TRSV_REG_CFG_EXYNOS9610(o, v, d) \
+	PHY_TRSV_REG_CFG_OFFSET(o, v, d, PHY_EXYNOS9610_LANE_OFFSET)
+
+/* Calibration for phy initialization */
+static const struct samsung_ufs_phy_cfg exynos9610_pre_init_cfg[] = {
+	PHY_COMN_REG_CFG(0x023, 0x80, PWR_MODE_ANY),
+	PHY_COMN_REG_CFG(0x01d, 0x10, PWR_MODE_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x044, 0xb5, PWR_MODE_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x04d, 0x43, PWR_MODE_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x05b, 0x20, PWR_MODE_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x05e, 0xc0, PWR_MODE_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x06c, 0x94, PWR_MODE_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x038, 0x12, PWR_MODE_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x059, 0x58, PWR_MODE_ANY),
+	PHY_COMN_REG_CFG(0x023, 0xc0, PWR_MODE_ANY),
+	PHY_COMN_REG_CFG(0x023, 0x00, PWR_MODE_ANY),
+	END_UFS_PHY_CFG
+};
+
+/*
+ * Calibration for HS mode series A/B. Registers 0x04a, 0x04b and 0x04d take
+ * other values in gears 1 and 2; these are the ones for gear 3, the only gear
+ * the host asks for.
+ */
+static const struct samsung_ufs_phy_cfg exynos9610_pre_pwr_hs_cfg[] = {
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x032, 0xbc, PWR_MODE_HS_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x03c, 0x7f, PWR_MODE_HS_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x048, 0xc0, PWR_MODE_HS_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x04a, 0x00, PWR_MODE_HS_G3_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x04b, 0x10, PWR_MODE_HS_G3_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x04d, 0x63, PWR_MODE_HS_G3_ANY),
+	END_UFS_PHY_CFG
+};
+
+/* Nothing to write after the power mode change, only the CDR lock to wait for */
+static const struct samsung_ufs_phy_cfg exynos9610_post_pwr_hs_cfg[] = {
+	END_UFS_PHY_CFG
+};
+
+static const struct samsung_ufs_phy_cfg exynos9610_post_h8_enter[] = {
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x031, 0x99, PWR_MODE_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x03a, 0x7f, PWR_MODE_ANY),
+	PHY_COMN_REG_CFG(0x001, 0x02, PWR_MODE_ANY),
+	END_UFS_PHY_CFG
+};
+
+static const struct samsung_ufs_phy_cfg exynos9610_pre_h8_exit[] = {
+	PHY_COMN_REG_CFG(0x001, 0x00, PWR_MODE_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x031, 0xd9, PWR_MODE_ANY),
+	PHY_TRSV_REG_CFG_EXYNOS9610(0x03a, 0x77, PWR_MODE_ANY),
+	END_UFS_PHY_CFG
+};
+
+static const struct samsung_ufs_phy_cfg *exynos9610_ufs_phy_cfgs[CFG_TAG_MAX] = {
+	[CFG_PRE_INIT]		= exynos9610_pre_init_cfg,
+	[CFG_PRE_PWR_HS]	= exynos9610_pre_pwr_hs_cfg,
+	[CFG_POST_PWR_HS]	= exynos9610_post_pwr_hs_cfg,
+};
+
+static const struct samsung_ufs_phy_cfg *exynos9610_ufs_phy_hibern8_cfgs[] = {
+	[CFG_POST_HIBERN8_ENTER]	= exynos9610_post_h8_enter,
+	[CFG_PRE_HIBERN8_EXIT]		= exynos9610_pre_h8_exit,
+};
+
+static const char * const exynos9610_ufs_phy_clks[] = {
+	"ref_clk",
+};
+
+static int exynos9610_ufs_phy_wait_for_cdr_lock(struct phy *phy, u8 lane)
+{
+	struct samsung_ufs_phy *ufs_phy = get_samsung_ufs_phy(phy);
+	const unsigned int timeout_us = 100000;
+	const unsigned int sleep_us = 10;
+	u32 val;
+	int err;
+
+	err = readl_poll_timeout(ufs_phy->reg_pma +
+				 PHY_APB_ADDR(PHY_EXYNOS9610_CDR_LOCK_STATUS +
+					      lane * PHY_EXYNOS9610_LANE_OFFSET),
+				 val, (val & PHY_EXYNOS9610_CDR_LOCK_BIT),
+				 sleep_us, timeout_us);
+	if (err)
+		dev_err(ufs_phy->dev,
+			"failed to get phy cdr lock acquisition %d\n", err);
+
+	return err;
+}
+
+const struct samsung_ufs_phy_drvdata exynos9610_ufs_phy = {
+	.cfgs = exynos9610_ufs_phy_cfgs,
+	.cfgs_hibern8 = exynos9610_ufs_phy_hibern8_cfgs,
+	.isol = {
+		.offset = EXYNOS9610_EMBEDDED_UFS_PHY_CTRL,
+		.mask = EXYNOS9610_EMBEDDED_UFS_PHY_CTRL_MASK,
+		.en = EXYNOS9610_EMBEDDED_UFS_PHY_CTRL_EN,
+	},
+	.clk_list = exynos9610_ufs_phy_clks,
+	.num_clks = ARRAY_SIZE(exynos9610_ufs_phy_clks),
+	.wait_for_cdr = exynos9610_ufs_phy_wait_for_cdr_lock,
+};
