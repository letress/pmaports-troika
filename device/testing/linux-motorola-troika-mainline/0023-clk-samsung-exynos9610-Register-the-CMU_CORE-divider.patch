From 53a343ffc99a8bbb74036a9019cceeac7bba082e Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Wed, 11 Nov 2026 13:43:28 +0100
Subject: [PATCH 23/52] clk: samsung: exynos9610: Register the CMU_CORE
 dividers

core_div_clks is defined but never referenced from core_cmu_info, so
dout_clk_core_busp is not registered. It is the parent of the GIC mux
and of 41 gates in CMU_CORE, all of which become orphans.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/clk/samsung/clk-exynos9610.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/clk/samsung/clk-exynos9610.c b/drivers/clk/samsung/clk-exynos9610.c
index 2b6eebb..8f45434 100644
--- a/drivers/clk/samsung/clk-exynos9610.c
+++ b/drivers/clk/samsung/clk-exynos9610.c
@@ -2671,6 +2671,8 @@ static const struct samsung_gate_clock core_gate_clks[] __initconst = {
 static const struct samsung_cmu_info core_cmu_info __initconst = {
 	.mux_clks		= core_mux_clks,
 	.nr_mux_clks		= ARRAY_SIZE(core_mux_clks),
+	.div_clks		= core_div_clks,
+	.nr_div_clks		= ARRAY_SIZE(core_div_clks),
 	.gate_clks		= core_gate_clks,
 	.nr_gate_clks		= ARRAY_SIZE(core_gate_clks),
 	.clk_regs		= core_clk_regs,
