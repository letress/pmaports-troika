From 317b88fa6f75e84e43f8fc098c867cdc67f56998 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Thu, 12 Nov 2026 21:57:45 +0100
Subject: [PATCH 94/95] arm64: dts: exynos9610: Throttle the GPU when it gets
 hot

Let the GPU zone lower the highest allowed rate of the GPU above 88
degrees Celsius. The temperature, its hysteresis and the polling delay
are those of the control trip of the GPU zone in the vendor device tree,
which also maps it to the whole range of the GPU cooling device.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/exynos9610.dtsi | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos9610.dtsi b/arch/arm64/boot/dts/exynos/exynos9610.dtsi
index 2f9d30d..83e96c6 100644
--- a/arch/arm64/boot/dts/exynos/exynos9610.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos9610.dtsi
@@ -9,6 +9,7 @@
 #include <dt-bindings/clock/samsung,exynos9610-cmu.h>
 #include <dt-bindings/interrupt-controller/arm-gic.h>
 #include <dt-bindings/soc/samsung,exynos-usi.h>
+#include <dt-bindings/thermal/thermal.h>
 
 / {
 	compatible = "samsung,exynos9610";
@@ -599,17 +600,30 @@ pinctrl_dispaud: pinctrl@14a60000 {
 
 	thermal-zones {
 		gpu-thermal {
-			polling-delay-passive = <0>;
+			polling-delay-passive = <100>;
 			polling-delay = <1000>;
 			thermal-sensors = <&tmu 0>;
 
 			trips {
+				gpu_passive: gpu-passive {
+					temperature = <88000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
 				gpu-crit {
 					temperature = <105000>;
 					hysteresis = <0>;
 					type = "critical";
 				};
 			};
+
+			cooling-maps {
+				map0 {
+					trip = <&gpu_passive>;
+					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
 		};
 
 		little-thermal {
