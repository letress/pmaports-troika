From 3557a7b4b01a34de9f105474a1de45129b8b81d1 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Thu, 12 Nov 2026 18:53:53 +0100
Subject: [PATCH 86/94] dt-bindings: thermal: Add the TMU of the Samsung
 Exynos9610

The Exynos9610 has one TMU controller with three temperature probes, in
the GPU and in the two CPU clusters. The existing Exynos binding
describes controllers with a single sensor, so give this one its own
binding with a sensor specifier that selects the probe.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 .../thermal/samsung,exynos9610-tmu.yaml       | 57 +++++++++++++++++++
 1 file changed, 57 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/thermal/samsung,exynos9610-tmu.yaml

diff --git a/Documentation/devicetree/bindings/thermal/samsung,exynos9610-tmu.yaml b/Documentation/devicetree/bindings/thermal/samsung,exynos9610-tmu.yaml
new file mode 100644
index 0000000..ad61ef0
--- /dev/null
+++ b/Documentation/devicetree/bindings/thermal/samsung,exynos9610-tmu.yaml
@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/thermal/samsung,exynos9610-tmu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung Exynos9610 Thermal Management Unit (TMU)
+
+maintainers:
+  - letress <212964567+letress@users.noreply.github.com>
+
+description:
+  The TMU of the Exynos9610 is one controller with three temperature probes.
+  Probe 0 sits in the GPU, probe 1 in the Cortex-A53 cluster and probe 2 in
+  the Cortex-A73 cluster. The thermal sensor specifier is the number of the
+  probe.
+
+allOf:
+  - $ref: thermal-sensor.yaml#
+
+properties:
+  compatible:
+    const: samsung,exynos9610-tmu
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  '#thermal-sensor-cells':
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - '#thermal-sensor-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/samsung,exynos9610-cmu.h>
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+
+    thermal-sensor@10070000 {
+        compatible = "samsung,exynos9610-tmu";
+        reg = <0x10070000 0x700>;
+        interrupts = <GIC_SPI 231 IRQ_TYPE_LEVEL_HIGH>;
+        clocks = <&cmu_peri CLK_GOUT_PERI_BUSIF_TMU_PCLK>;
+        #thermal-sensor-cells = <1>;
+    };
