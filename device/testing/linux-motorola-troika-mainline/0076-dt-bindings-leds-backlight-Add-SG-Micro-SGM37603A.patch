From fc4a09ea0e5bf05be4c905bd101a91a31c6d85ec Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Thu, 12 Nov 2026 14:08:39 +0100
Subject: [PATCH 76/94] dt-bindings: leds: backlight: Add SG Micro SGM37603A

The SGM37603A is a white LED driver for three strings with a 12-bit
brightness code set over I2C.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 .../leds/backlight/sgmicro,sgm37603a.yaml     | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/leds/backlight/sgmicro,sgm37603a.yaml

diff --git a/Documentation/devicetree/bindings/leds/backlight/sgmicro,sgm37603a.yaml b/Documentation/devicetree/bindings/leds/backlight/sgmicro,sgm37603a.yaml
new file mode 100644
index 0000000..1417f00
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/backlight/sgmicro,sgm37603a.yaml
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/backlight/sgmicro,sgm37603a.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: SG Micro SGM37603A 3-string white LED driver
+
+maintainers:
+  - letress <212964567+letress@users.noreply.github.com>
+
+description:
+  The SGM37603A drives up to three strings of white LEDs from a boost
+  converter. The LED current follows a 12-bit brightness code set over I2C,
+  a PWM input, or the product of the two.
+
+allOf:
+  - $ref: common.yaml#
+
+properties:
+  compatible:
+    const: sgmicro,sgm37603a
+
+  reg:
+    maxItems: 1
+
+  max-brightness:
+    maximum: 4095
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        backlight@36 {
+            compatible = "sgmicro,sgm37603a";
+            reg = <0x36>;
+            max-brightness = <3276>;
+        };
+    };
