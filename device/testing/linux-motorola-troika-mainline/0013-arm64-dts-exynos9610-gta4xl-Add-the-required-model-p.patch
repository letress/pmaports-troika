From e036c92345689426cb2f59f857db4bbd977df166 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Tue, 10 Nov 2026 15:37:13 +0100
Subject: [PATCH 13/17] arm64: dts: exynos9610-gta4xl: Add the required model
 property

The root node has no model, which the root-node schema requires:

  / (samsung,gta4xl): 'model' is a required property

Use the device name from the commit that added the board.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/exynos9610-gta4xl.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos9610-gta4xl.dts b/arch/arm64/boot/dts/exynos/exynos9610-gta4xl.dts
index 24232bd..d59a0fc 100644
--- a/arch/arm64/boot/dts/exynos/exynos9610-gta4xl.dts
+++ b/arch/arm64/boot/dts/exynos/exynos9610-gta4xl.dts
@@ -12,6 +12,7 @@
 #include <dt-bindings/input/input.h>
 
 / {
+	model = "Samsung Galaxy Tab S6 Lite (SM-P610/P615)";
 	compatible = "samsung,gta4xl", "samsung,exynos9610";
 	#address-cells = <2>;
 	#size-cells = <1>;
