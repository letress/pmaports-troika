From fcedfbeed8abddb7163e05b6e9a8d76d861dd56c Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Thu, 12 Nov 2026 15:06:02 +0100
Subject: [PATCH 79/94] dt-bindings: display: simple-framebuffer: Add a
 backlight

A display that the firmware has set up comes with its backlight on.
Nothing ties the two together, so the backlight stays on while the
display is disabled. Let the framebuffer node name its backlight.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 .../devicetree/bindings/display/simple-framebuffer.yaml     | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Documentation/devicetree/bindings/display/simple-framebuffer.yaml b/Documentation/devicetree/bindings/display/simple-framebuffer.yaml
index 45ffdeb..5ba0a04 100644
--- a/Documentation/devicetree/bindings/display/simple-framebuffer.yaml
+++ b/Documentation/devicetree/bindings/display/simple-framebuffer.yaml
@@ -126,6 +126,12 @@ properties:
     $ref: /schemas/types.yaml#/definitions/phandle
     description: Display panel node
 
+  backlight:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Backlight of the display. It is on when the firmware hands over the
+      framebuffer and may be turned off while the display is not in use.
+
   allwinner,pipeline:
     description: Pipeline used by the framebuffer on Allwinner SoCs
     enum:
