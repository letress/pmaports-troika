From 5adaa3367f8ea84fb7bc5d981a5610132bc3cda6 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Tue, 10 Nov 2026 15:39:08 +0100
Subject: [PATCH 17/17] arm64: dts: exynos: Add Motorola One Action (troika)

Add a minimal device tree for the Motorola One Action (XT2013, codename
troika), an Exynos9609 phone. Enough is described to get a kernel log
on the display and working hardware keys:

- memory layout
- bootloader framebuffer through simple-framebuffer (1080x2520)
- volume and power keys

No clocks, regulators, storage or USB are described; the kernel relies
on what the bootloader left enabled.

Where the values come from:

- Memory regions and the fixed reserved regions were read from the
  device tree the stock bootloader (MBM-2.2) passes to the vendor
  kernel (/sys/firmware/fdt on an XT2013-2 with 4 GB RAM). They differ
  from gta4xl, which uses another bootloader.
- The bootloader reserves 64 MiB at 0xec000000 for its framebuffer
  ("bootloader_fb" in the vendor tree), but scans out from 0xed000000,
  16 MiB into that region. This is what the DPU reports: the one active
  DMA channel (G0) has its buffer address set to 0xed000000 with a
  1080x2520 source and image size. Drawing at 0xec000000 has no visible
  effect, drawing at 0xed000000 does. The panel is 1080x2520 (Himax
  HX83112A on the unit the values were read from, Novatek NT36672A on
  others; same resolution). The format was checked by drawing known
  colours into the buffer from a second-stage loader.
- Keys are gpa1-5 (volume up), gpa1-6 (volume down) and gpa1-7 (power),
  as in the vendor tree. All three lines read high when idle, so they
  are active low.
- The external oscillator is 26 MHz, as registered by the vendor clock
  driver.

Besides the framebuffer, six more regions the bootloader reserves for
the vendor kernel (secure log, ABOX, modem, debug snapshot, GNSS, sensor
hub) are marked no-map. Mainline has no users for them, but it is not
known whether firmware keeps writing there, so keep the kernel out.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/Makefile           |   1 +
 .../boot/dts/exynos/exynos9610-troika.dts     | 145 ++++++++++++++++++
 2 files changed, 146 insertions(+)
 create mode 100644 arch/arm64/boot/dts/exynos/exynos9610-troika.dts

diff --git a/arch/arm64/boot/dts/exynos/Makefile b/arch/arm64/boot/dts/exynos/Makefile
index e18f99a..eae4153 100644
--- a/arch/arm64/boot/dts/exynos/Makefile
+++ b/arch/arm64/boot/dts/exynos/Makefile
@@ -17,6 +17,7 @@ dtb-$(CONFIG_ARCH_EXYNOS) += \
 	exynos8855-smdk.dtb		\
 	exynos8895-dreamlte.dtb		\
 	exynos9610-gta4xl.dtb		\
+	exynos9610-troika.dtb		\
 	exynos9810-starlte.dtb		\
 	exynos990-c1s.dtb		\
 	exynos990-r8s.dtb               \
diff --git a/arch/arm64/boot/dts/exynos/exynos9610-troika.dts b/arch/arm64/boot/dts/exynos/exynos9610-troika.dts
new file mode 100644
index 0000000..90e45e2
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos9610-troika.dts
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Motorola One Action (troika, XT2013) device tree source
+ *
+ * The SoC is marketed as Exynos9609, a lower-clocked Exynos9610.
+ */
+
+/dts-v1/;
+
+#include "exynos9610.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/ {
+	model = "Motorola One Action";
+	compatible = "motorola,troika", "samsung,exynos9610";
+	chassis-type = "handset";
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * Left running by the bootloader, which scans out from 16 MiB
+		 * into its 64 MiB framebuffer region.
+		 */
+		framebuffer0: framebuffer@ed000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xed000000 (1080 * 2520 * 4)>;
+			width = <1080>;
+			height = <2520>;
+			stride = <(1080 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&key_voldown &key_volup &key_power>;
+		pinctrl-names = "default";
+
+		volup-key {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&gpa1 5 GPIO_ACTIVE_LOW>;
+		};
+
+		voldown-key {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&gpa1 6 GPIO_ACTIVE_LOW>;
+		};
+
+		power-key {
+			label = "Power";
+			linux,code = <KEY_POWER>;
+			gpios = <&gpa1 7 GPIO_ACTIVE_LOW>;
+			wakeup-source;
+		};
+	};
+
+	/* As passed by the MBM-2.2 bootloader on a 4 GB XT2013-2 */
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x3c800000>,
+		      <0x0 0xc0000000 0x20000000>,
+		      <0x0 0xe0d00000 0x1f300000>,
+		      <0x8 0x80000000 0x80000000>;
+	};
+
+	/*
+	 * Fixed regions the bootloader hands to the vendor kernel. Only the
+	 * framebuffer is used here; the others are kept out of the page
+	 * allocator because firmware may still write to them.
+	 */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		seclog@c0000000 {
+			reg = <0x0 0xc0000000 0x80000>;
+			no-map;
+		};
+
+		abox@e9400000 {
+			reg = <0x0 0xe9400000 0x400000>;
+			no-map;
+		};
+
+		framebuffer@ec000000 {
+			reg = <0x0 0xec000000 0x4000000>;
+			no-map;
+		};
+
+		modem@f0000000 {
+			reg = <0x0 0xf0000000 0x8a00000>;
+			no-map;
+		};
+
+		debug-snapshot@f9000000 {
+			reg = <0x0 0xf9000000 0x1610000>;
+			no-map;
+		};
+
+		gnss@fb000000 {
+			reg = <0x0 0xfb000000 0x800000>;
+			no-map;
+		};
+
+		chub@fd000000 {
+			reg = <0x0 0xfd000000 0x50000>;
+			no-map;
+		};
+	};
+};
+
+&oscclk {
+	clock-frequency = <26000000>;
+};
+
+&pinctrl_alive {
+	key_power: key-power-pins {
+		samsung,pins = "gpa1-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	key_voldown: key-voldown-pins {
+		samsung,pins = "gpa1-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	key_volup: key-volup-pins {
+		samsung,pins = "gpa1-5";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+};
