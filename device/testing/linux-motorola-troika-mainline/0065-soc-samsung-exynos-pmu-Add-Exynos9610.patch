From 1e51e491221e02089d0312d2ad5f512f1f894ddc Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Wed, 11 Nov 2026 22:51:41 +0100
Subject: [PATCH 65/94] soc: samsung: exynos-pmu: Add Exynos9610

Match the Exynos9610 PMU so that its child nodes (reboot, poweroff and
reboot mode) get populated. Like Exynos850 it needs no PMU data.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/soc/samsung/exynos-pmu.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/soc/samsung/exynos-pmu.c b/drivers/soc/samsung/exynos-pmu.c
index efccdd6..88b0dfc 100644
--- a/drivers/soc/samsung/exynos-pmu.c
+++ b/drivers/soc/samsung/exynos-pmu.c
@@ -149,6 +149,8 @@ static const struct of_device_id exynos_pmu_of_device_ids[] = {
 		.compatible = "samsung,exynos7-pmu",
 	}, {
 		.compatible = "samsung,exynos850-pmu",
+	}, {
+		.compatible = "samsung,exynos9610-pmu",
 	},
 	{ /*sentinel*/ },
 };
