From 703fe5f072bb72735b1cbb12c7f5f0cef8ca3cce Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Wed, 11 Nov 2026 13:52:59 +0100
Subject: [PATCH 38/67] dt-bindings: clock: exynos9610: Add the G2D and MSCL
 gate IDs

The G2D and MSCL clock gates of CMU_G2D (CLK_CON_GAT_GOUT_G2D_G2D_CLK
and CLK_CON_GAT_GOUT_G2D_MSCL_CLK) have no clock IDs. Add them at the
end of the CMU_G2D list so the existing IDs keep their values.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 include/dt-bindings/clock/samsung,exynos9610-cmu.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/include/dt-bindings/clock/samsung,exynos9610-cmu.h b/include/dt-bindings/clock/samsung,exynos9610-cmu.h
index 9b39974..e8a2c5c 100644
--- a/include/dt-bindings/clock/samsung,exynos9610-cmu.h
+++ b/include/dt-bindings/clock/samsung,exynos9610-cmu.h
@@ -598,6 +598,8 @@
 #define CLK_GOUT_G2D_SYSMMU_CLK		23
 #define CLK_GOUT_G2D_SYSREG_PCLK	24
 #define CLK_GOUT_G2D_XIU_D_MSCL_ACLK	25
+#define CLK_GOUT_G2D_G2D_CLK		26
+#define CLK_GOUT_G2D_MSCL_CLK		27
 
 /* CMU_G3D PLLs */
 #define CLK_FOUT_G3D_PLL			1
