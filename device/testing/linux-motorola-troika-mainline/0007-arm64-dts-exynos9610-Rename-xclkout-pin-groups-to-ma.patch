From bdb5f4aca2056907864901b2e0c72b85e31da3c3 Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Tue, 10 Nov 2026 15:36:25 +0100
Subject: [PATCH 07/17] arm64: dts: exynos9610: Rename xclkout pin groups to
 match the binding

Pin configuration nodes must be named "*-pins". The two xclkout groups
of the ALIVE pin controller are not, which makes dtbs_check fail:

  pinctrl@11850000: 'xclkout0', 'xclkout1' do not match any of the
  regexes: ... '^[a-z0-9-]+-pins$' ...

Nothing references the node names, only the labels, which are kept.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/exynos9610-pinctrl.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos9610-pinctrl.dtsi b/arch/arm64/boot/dts/exynos/exynos9610-pinctrl.dtsi
index 79a2251..8583a23 100644
--- a/arch/arm64/boot/dts/exynos/exynos9610-pinctrl.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos9610-pinctrl.dtsi
@@ -90,13 +90,13 @@ uart0_bus: uart0-bus-pins {
 		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
 	};
 
-	xclkout1: xclkout1 {
+	xclkout1: xclkout1-pins {
 		samsung,pins = "gpq0-0";
 		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
 		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
 	};
 
-	xclkout0: xclkout0 {
+	xclkout0: xclkout0-pins {
 		samsung,pins = "gpq0-1";
 		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
 		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
