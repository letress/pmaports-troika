From d8489976ab959cf903e1879e3b8dfc104026607f Mon Sep 17 00:00:00 2001
From: letress <212964567+letress@users.noreply.github.com>
Date: Wed, 11 Nov 2026 13:43:27 +0100
Subject: [PATCH 22/95] clk: samsung: exynos9610: Fix name of the G3D switch
 mux

The mux is registered as "mout_cmu_g3d_SWITCH" while its only consumer,
the gout_cmu_g3d_switch gate, asks for "mout_cmu_g3d_switch". The gate
and everything below it (the G3D switch divider and the user mux in
CMU_G3D) end up orphaned. Use the lowercase name like every other clock.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 drivers/clk/samsung/clk-exynos9610.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/clk/samsung/clk-exynos9610.c b/drivers/clk/samsung/clk-exynos9610.c
index 7e72845..2b6eebb 100644
--- a/drivers/clk/samsung/clk-exynos9610.c
+++ b/drivers/clk/samsung/clk-exynos9610.c
@@ -562,7 +562,7 @@ static const struct samsung_mux_clock top_mux_clks[] __initconst = {
 	    CLK_CON_MUX_MUX_CLKCMU_G2D_G2D, 0, 2),
 	MUX(CLK_MOUT_CMU_G2D_MSCL, "mout_cmu_g2d_mscl", mout_cmu_g2d_mscl_p,
 	    CLK_CON_MUX_MUX_CLKCMU_G2D_MSCL, 0, 2),
-	MUX(CLK_MOUT_CMU_G3D_SWITCH, "mout_cmu_g3d_SWITCH", mout_cmu_g3d_switch_p,
+	MUX(CLK_MOUT_CMU_G3D_SWITCH, "mout_cmu_g3d_switch", mout_cmu_g3d_switch_p,
 	    CLK_CON_MUX_MUX_CLKCMU_G3D_SWITCH, 0, 2),
 	MUX(CLK_MOUT_CMU_HPM, "mout_cmu_hpm", mout_cmu_hpm_p,
 	    CLK_CON_MUX_MUX_CLKCMU_HPM, 0, 3),
