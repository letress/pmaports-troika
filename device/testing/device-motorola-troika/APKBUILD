# Reference: <https://nura.eco/devicepkg>
pkgname=device-motorola-troika
pkgdesc="Motorola One Action"
pkgver=1
pkgrel=9
url="https://nura.eco"
license="MIT AND GPL-2.0-only"
arch="aarch64"
options="!check !archcheck"
depends="
	android-tools-mkbootimg
	firmware-motorola-troika
	linux-motorola-troika-mainline
	postmarketos-base
	util-linux-misc
"
makedepends="devicepkg-dev"
subpackages="$pkgname-phosh"
# exynos9610-troika-vendor.dtb is the unmodified exynos9610.dtb of the vendor
# kernel (GPL-2.0), as shipped in the "second" slot of the LineageOS 22 boot
# image; source: github.com/LineageOS/android_kernel_motorola_exynos9610 at
# 809b8162409a, arch/arm64/boot/dts/exynos/exynos9610.dts. The bootloader does
# not start a boot image without it. Building it from source instead of
# shipping the blob is left for later.
source="
	deviceinfo
	exynos9610-troika-vendor.dtb
	60-ufs-readonly.rules
	20-ufs-readonly.files
	ufs-readonly.sh
	phoc.ini
	phosh-builtin-display.conf
	70-wlan-mac.rules
	wlan-mac.sh
	wlan.conf
	bt-addr.sh
	bluetooth.conf
	bluetooth-modprobe.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/exynos9610-troika-vendor.dtb \
		-t "$pkgdir"/boot/dtbs/vendor
	install -Dm644 "$srcdir"/60-ufs-readonly.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d
	install -Dm644 "$srcdir"/20-ufs-readonly.files \
		-t "$pkgdir"/usr/share/mkinitfs/files
	install -Dm644 "$srcdir"/ufs-readonly.sh \
		"$pkgdir"/usr/share/mkinitfs/hooks/00-ufs-readonly.sh

	# WLAN: load the driver at boot and give it the factory address
	install -Dm644 "$srcdir"/wlan.conf \
		"$pkgdir"/usr/lib/modules-load.d/motorola-troika-wlan.conf
	install -Dm644 "$srcdir"/70-wlan-mac.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d
	install -Dm755 "$srcdir"/wlan-mac.sh \
		-t "$pkgdir"/usr/libexec/motorola-troika

	# Bluetooth: write the factory address, then load the driver at boot
	install -Dm755 "$srcdir"/bt-addr.sh \
		-t "$pkgdir"/usr/libexec/motorola-troika
	install -Dm644 "$srcdir"/bluetooth-modprobe.conf \
		"$pkgdir"/usr/lib/modprobe.d/motorola-troika-bluetooth.conf
	install -Dm644 "$srcdir"/bluetooth.conf \
		"$pkgdir"/usr/lib/modules-load.d/motorola-troika-bluetooth.conf
}

phosh() {
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-phosh"

	install -Dm644 "$srcdir"/phoc.ini \
		"$subpkgdir"/etc/phosh/phoc.ini
	install -Dm644 "$srcdir"/phosh-builtin-display.conf \
		"$subpkgdir"/usr/lib/systemd/user/mobi.phosh.Shell.service.d/50-builtin-display.conf
}

