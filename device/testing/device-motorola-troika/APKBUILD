b3efad9d5fb5f7910cf2bd70cf3c22970e9c5728f823cf15c6ebde93b5096d06f0033877acd0ea0dd3c2bd03e41814f8c9b58c28e8d52ce94b185e230278e617  exynos9610-troika-vendor.dtb
"
