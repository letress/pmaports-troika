# Reference: <https://nura.eco/devicepkg>
pkgname=device-motorola-troika
pkgdesc="Motorola One Action"
pkgver=1
pkgrel=1
url="https://nura.eco"
license="MIT AND GPL-2.0-only"
arch="aarch64"
options="!check !archcheck"
depends="
	android-tools-mkbootimg
	linux-motorola-troika-mainline
	postmarketos-base
"
makedepends="devicepkg-dev"
# exynos9610-troika-vendor.dtb is the unmodified exynos9610.dtb of the vendor
# kernel (GPL-2.0), as shipped in the "second" slot of the LineageOS 22 boot
# image; source: github.com/LineageOS/android_kernel_motorola_exynos9610 at
# 809b8162409a, arch/arm64/boot/dts/exynos/exynos9610.dts. The bootloader does
# not start a boot image without it. Building it from source instead of
# shipping the blob is left for later.
source="
	deviceinfo
	exynos9610-troika-vendor.dtb
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/exynos9610-troika-vendor.dtb \
		-t "$pkgdir"/boot/dtbs/vendor
}

sha512sums="
